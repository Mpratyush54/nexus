<Window x:Class="Nexus.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nexus Setup" Width="720" Height="460"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" Background="#0E0F0E"
        FontFamily="Segoe UI Variable Text, Segoe UI" TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Cream" Color="#F2EFE6"/>
    <SolidColorBrush x:Key="Gold" Color="#E8BB63"/>
    <SolidColorBrush x:Key="Muted" Color="#9A978E"/>
    <SolidColorBrush x:Key="Faint" Color="#6E6C66"/>
    <SolidColorBrush x:Key="Hair" Color="#1FFFFFFF"/>

    <!-- One big primary action: cream on ink, warms to gold on hover. -->
    <Style x:Key="Primary" TargetType="Button">
      <Setter Property="Foreground" Value="#0E0F0E"/>
      <Setter Property="Background" Value="#F2EFE6"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Height" Value="46"/>
      <Setter Property="MinWidth" Value="220"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="Halo" CornerRadius="14" Margin="-3" BorderBrush="#E8BB63" BorderThickness="2" Opacity="0"/>
              <Border x:Name="Face" CornerRadius="11">
                <Border.Background><SolidColorBrush Color="#F2EFE6"/></Border.Background>
                <Border.Effect>
                  <DropShadowEffect Color="#E8BB63" BlurRadius="24" ShadowDepth="0" Opacity="0.0"/>
                </Border.Effect>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="28,0"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <ColorAnimation Storyboard.TargetName="Face" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#F5D79A" Duration="0:0:0.18"/>
                      <DoubleAnimation Storyboard.TargetName="Face" Storyboard.TargetProperty="(Border.Effect).(DropShadowEffect.Opacity)" To="0.45" Duration="0:0:0.18"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <ColorAnimation Storyboard.TargetName="Face" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" Duration="0:0:0.25"/>
                      <DoubleAnimation Storyboard.TargetName="Face" Storyboard.TargetProperty="(Border.Effect).(DropShadowEffect.Opacity)" To="0" Duration="0:0:0.25"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Halo" Property="Opacity" Value="1"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Face" Property="RenderTransform">
                  <Setter.Value><ScaleTransform ScaleX="0.98" ScaleY="0.98" CenterX="110" CenterY="23"/></Setter.Value>
                </Setter>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Face" Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Link" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="Transparent" Padding="6,3" CornerRadius="6" BorderThickness="1" BorderBrush="Transparent">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#F2EFE6"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#E8BB63"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Caption" TargetType="Button">
      <Setter Property="Width" Value="40"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="Transparent" CornerRadius="8" Margin="2">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="#1AFFFFFF"/>
                <Setter Property="Foreground" Value="#F2EFE6"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="Background" Value="#1AFFFFFF"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.3"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Quiet rounded checkbox with a gold tick. -->
    <Style x:Key="Check" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Cream}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="Box" Width="18" Height="18" CornerRadius="5" BorderThickness="1.2" BorderBrush="#55F2EFE6" Background="Transparent" VerticalAlignment="Center">
                <TextBlock x:Name="Tick" Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Foreground="#0E0F0E" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0"/>
              </Border>
              <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="Background" Value="#E8BB63"/>
                <Setter TargetName="Box" Property="BorderBrush" Value="#E8BB63"/>
                <Setter TargetName="Tick" Property="Opacity" Value="1"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#F5D79A"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border x:Name="Frame" Background="Transparent">
    <Grid x:Name="Root">
      <!-- Ambient light: warm top-left, cool bottom-right. -->
      <Rectangle x:Name="Tint" Fill="#E00E0F0E"/>
      <Ellipse Width="520" Height="420" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-200,-220,0,0" IsHitTestVisible="False">
        <Ellipse.Fill>
          <RadialGradientBrush><GradientStop Color="#30E8BB63" Offset="0"/><GradientStop Color="#00E8BB63" Offset="1"/></RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>
      <Ellipse Width="560" Height="460" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-260,-280" IsHitTestVisible="False">
        <Ellipse.Fill>
          <RadialGradientBrush><GradientStop Color="#228EA2FF" Offset="0"/><GradientStop Color="#008EA2FF" Offset="1"/></RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>

      <Grid x:Name="ContentGrid">
        <Grid.RowDefinitions>
          <RowDefinition Height="40"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title bar: drag anywhere; custom minimise / close. -->
        <Grid x:Name="TitleBar" Background="Transparent">
          <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
            <Image x:Name="TitleMark" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Text="Nexus" Margin="8,0,0,0" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,6,0" VerticalAlignment="Top">
            <Button x:Name="MinButton" Style="{StaticResource Caption}" Content="&#xE921;" AutomationProperties.Name="Minimize" ToolTip="Minimize"/>
            <Button x:Name="CloseButton" Style="{StaticResource Caption}" Content="&#xE8BB;" AutomationProperties.Name="Close" ToolTip="Close"/>
          </StackPanel>
        </Grid>

        <!-- Screens -->
        <Grid Grid.Row="1" x:Name="Screens">
          <!-- 1 Welcome -->
          <StackPanel x:Name="Welcome" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,-14,0,0">
            <Border x:Name="HeroHost" HorizontalAlignment="Center" Height="150" ClipToBounds="False"/>
            <TextBlock x:Name="Headline" Text="Nexus" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="34" FontWeight="SemiBold" Foreground="{StaticResource Cream}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            <TextBlock x:Name="Tagline" Text="Shared memory for your AI agents" FontSize="15.5" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            <Border x:Name="ExistingPill" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,12,0,0" Padding="12,5" CornerRadius="999" Background="#14FFFFFF" BorderBrush="#24E8BB63" BorderThickness="1">
              <TextBlock x:Name="ExistingText" FontSize="12" Foreground="{StaticResource Cream}"/>
            </Border>
            <Button x:Name="InstallButton" Style="{StaticResource Primary}" Content="Install" Margin="0,22,0,0" HorizontalAlignment="Center" AutomationProperties.Name="Install Nexus"/>
            <Button x:Name="OptionsButton" Style="{StaticResource Link}" HorizontalAlignment="Center" Margin="0,10,0,0" AutomationProperties.Name="Install options">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Options"/>
                <TextBlock x:Name="OptionsChevron" Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9" Margin="6,2,0,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                  <TextBlock.RenderTransform><RotateTransform x:Name="ChevronTurn"/></TextBlock.RenderTransform>
                </TextBlock>
              </StackPanel>
            </Button>
            <Border x:Name="OptionsPanel" MaxHeight="0" Opacity="0" ClipToBounds="True" Width="420" Margin="0,8,0,0">
              <Border Padding="18,14" CornerRadius="12" Background="#0FFFFFFF" BorderBrush="{StaticResource Hair}" BorderThickness="1">
                <StackPanel>
                  <TextBlock Text="INSTALL LOCATION" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Faint}"/>
                  <Grid Margin="0,6,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="LocationText" FontSize="12.5" Foreground="{StaticResource Cream}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <Button x:Name="ChangeLocation" Grid.Column="1" Style="{StaticResource Link}" Content="Change…" AutomationProperties.Name="Change install location"/>
                  </Grid>
                  <CheckBox x:Name="DesktopShortcut" Style="{StaticResource Check}" Content="Add a desktop shortcut"/>
                  <CheckBox x:Name="StartAtLogin" Style="{StaticResource Check}" Content="Start Nexus when I sign in" Margin="0,10,0,0"/>
                </StackPanel>
              </Border>
            </Border>
          </StackPanel>

          <!-- 2 Installing: progress is the graph forming. -->
          <Grid x:Name="Installing" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,-10,0,0">
              <Border x:Name="GraphHost" HorizontalAlignment="Center"/>
              <Grid Margin="0,22,0,0" Height="24">
                <TextBlock x:Name="StatusA" FontSize="15" Foreground="{StaticResource Cream}" HorizontalAlignment="Center"/>
                <TextBlock x:Name="StatusB" FontSize="15" Foreground="{StaticResource Cream}" HorizontalAlignment="Center" Opacity="0"/>
              </Grid>
              <TextBlock x:Name="Percent" FontSize="11.5" Foreground="{StaticResource Faint}" HorizontalAlignment="Center" Margin="0,6,0,0" Typography.NumeralAlignment="Tabular"/>
            </StackPanel>
          </Grid>

          <!-- 3 Done -->
          <Grid x:Name="Done" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,-14,0,0">
              <Border x:Name="DoneGraphHost" HorizontalAlignment="Center"/>
              <TextBlock x:Name="DoneTitle" Text="You're all set" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource Cream}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
              <TextBlock x:Name="DoneSub" FontSize="13.5" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
              <Button x:Name="OpenButton" Style="{StaticResource Primary}" Content="Open Nexus" Margin="0,20,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
          </Grid>

          <!-- Errors: friendly, with retry. -->
          <Grid x:Name="Failed" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="440" Margin="0,-14,0,0">
              <Border Width="56" Height="56" CornerRadius="28" Background="#26E8BB63" HorizontalAlignment="Center">
                <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="22" Foreground="{StaticResource Gold}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBlock Text="Nexus couldn't be installed" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource Cream}" HorizontalAlignment="Center" Margin="0,18,0,0"/>
              <TextBlock x:Name="FailedText" FontSize="13.5" Foreground="{StaticResource Muted}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"/>
              <TextBlock x:Name="FailedDetail" FontSize="11.5" Foreground="{StaticResource Faint}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0" FontFamily="Cascadia Mono, Consolas"/>
              <Button x:Name="RetryButton" Style="{StaticResource Primary}" Content="Try again" Margin="0,22,0,0" HorizontalAlignment="Center"/>
              <Button x:Name="LogButton" Style="{StaticResource Link}" Content="Open the setup log" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>
          </Grid>

          <!-- Privacy sheet (fine print link) -->
          <Border x:Name="PrivacySheet" Visibility="Collapsed" Margin="64,4,64,8" CornerRadius="14" Background="#F2141514" BorderBrush="{StaticResource Hair}" BorderThickness="1" Padding="24,20">
            <StackPanel>
              <TextBlock Text="Your data and Nexus" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Cream}"/>
              <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource Muted}" Margin="0,10,0,0" LineHeight="19">
                Nexus monitors only the folders you approve during setup. It captures chats, tool activity and workspace context from your coding agents, and syncs them and the memories extracted from them to your account. Sharing is always a separate action. You can pause capture at any time, and uninstalling asks whether to remove local data. Nexus installs for you only and never needs admin rights.
              </TextBlock>
              <Button x:Name="PrivacyClose" Style="{StaticResource Link}" Content="Close" HorizontalAlignment="Right" Margin="0,12,0,0"/>
            </StackPanel>
          </Border>
        </Grid>

        <!-- Fine print -->
        <StackPanel x:Name="FinePrint" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,14">
          <TextBlock x:Name="VersionText" FontSize="11" Foreground="{StaticResource Faint}" VerticalAlignment="Center"/>
          <TextBlock Text="  ·  " FontSize="11" Foreground="{StaticResource Faint}" VerticalAlignment="Center"/>
          <Button x:Name="PrivacyLink" Style="{StaticResource Link}" FontSize="11" Content="Privacy"/>
          <Button x:Name="SourceLink" Style="{StaticResource Link}" FontSize="11" Content="Source &amp; license"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
