# workspace-daemon — user-machine image (issue #20; hardened per #112/#126).
# Build context: repo root. The daemon is normally a local Go binary; this
# image exists for Docker-based dev/test and parity with the server toolchain.
#
# Single port: 7687 everywhere (binary -port default, compose mapping, EXPOSE).
# Env contract: CENTRAL_SERVER_URL (read by the binary; empty = local-only),
# CENTRAL_USER_ID (required for server Register; see #126). DAEMON_ADDR and
# DAEMON_PORT are dead (the binary reads neither) and are NOT set here.
# WORKDIR is /workspace so the default -root /workspace serves the compose
# mount. git is installed: /git/* routes and allowlisted git commands need it
# in PATH (ADR-020).
#
# Bind: -bind defaults to 127.0.0.1 (local-first); containers pass
# -bind 0.0.0.0 via CMD below so the mapped 7687 is reachable ($DAEMON_BIND
# also works). Register/heartbeat (daemon -> server, outbound) work either way.

FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -o /out/workspace-daemon ./cmd/daemon

FROM alpine:3.21
RUN apk add --no-cache git wget \
  && adduser -D -u 10001 appuser
COPY --from=build /out/workspace-daemon /usr/local/bin/workspace-daemon
WORKDIR /workspace
RUN chown 10001:10001 /workspace
USER 10001
EXPOSE 7687
ENV CENTRAL_SERVER_URL="" \
    CENTRAL_USER_ID=""
HEALTHCHECK --interval=30s --timeout=5s --retries=3 --start-period=30s \
  CMD wget -q -O /dev/null http://localhost:7687/heartbeat || test $? -eq 8
# NOTE: any HTTP response (including 401 auth-required) proves liveness;
# wget exit 8 = server error response = socket alive. A real /healthz needs
# an internal/daemon change (out of scope for deploy fixes).
ENTRYPOINT ["/usr/local/bin/workspace-daemon"]
CMD ["-root", "/workspace", "-port", "7687", "-bind", "0.0.0.0"]
