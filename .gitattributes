# Enforce LF line endings so gofmt is OS-independent.
# Without this, Windows checkouts convert to CRLF and `gofmt -l` flags
# every file, failing the build+vet+gofmt job on windows-latest only.
* text=auto eol=lf
*.go text eol=lf
*.mod text eol=lf
*.sum text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
