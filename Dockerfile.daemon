# Dockerfile.daemon — workspace daemon (issue #20, plan §1.3).
#
# Multi-stage: Go builder compiles deploy/daemon-bootstrap (CGO-free static
# binary). Runtime is Alpine + git: the daemon serves sandboxed
# /git/status, /git/diff and allowlisted `git` test commands, so a git
# binary must exist in PATH. ca-certificates cover TLS register/heartbeat
# back to the central server.
#
# Runtime env:
#   WORKSPACE_ROOT      (default /workspace — mount the project here)
#   CENTRAL_SERVER_URL  (optional; empty = local-only mode)
#   DAEMON_ADDR         (default :7687)
#   MACHINE_ID          (optional override for hostname)
#
# Probes:  GET /healthz (open; all other routes need the bearer token at
#          <root>/.central-memory/daemon.token, mode 0600)
# Build:   docker build -f Dockerfile.daemon -t central-memory-daemon .
# Run:     docker run -v $(pwd):/workspace -p 7687:7687 central-memory-daemon

FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/daemon ./deploy/daemon-bootstrap

FROM alpine:3.21
RUN apk add --no-cache ca-certificates tzdata git \
    && adduser -D -H -u 10001 appuser
WORKDIR /app
COPY --from=build /out/daemon /app/daemon
# /workspace is the mount point; owned by appuser so token writes (0600) work rootless.
RUN mkdir -p /workspace && chown appuser /workspace
USER appuser
EXPOSE 7687
ENV WORKSPACE_ROOT=/workspace DAEMON_ADDR=:7687
ENTRYPOINT ["/app/daemon"]
