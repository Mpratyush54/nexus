{
  "_comment": "SAMPLE ecs-task.json — Fargate task definition template for central-server. Fill in ACCOUNT/REGION/secret ARNs before registering. Templates/notes only — do not apply blindly.",
  "family": "central-server",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::ACCOUNT:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::ACCOUNT:role/central-server-task-role",
  "containerDefinitions": [
    {
      "name": "central-server",
      "image": "ACCOUNT.dkr.ecr.REGION.amazonaws.com/central-server:COMMIT_SHA",
      "essential": true,
      "portMappings": [{ "containerPort": 8080, "protocol": "tcp" }],
      "environment": [
        { "name": "PORT", "value": "8080" },
        { "name": "MIGRATIONS_DIR", "value": "/migrations" }
      ],
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:REGION:ACCOUNT:secret:central-memory/database-url:database_url::"
        },
        {
          "name": "CENTRAL_MEMORY_JWT_KEY",
          "valueFrom": "arn:aws:secretsmanager:REGION:ACCOUNT:secret:central-memory/jwt-key:jwt_key::"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/central-server",
          "awslogs-region": "REGION",
          "awslogs-stream-prefix": "server"
        }
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "wget -q -O - http://localhost:8080/healthz || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      }
    }
  ]
}
