<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Nexus.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Typography and shape (reference: T3 Code). System UI font, quiet
                 6px controls, 10px overlays. -->
            <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
            <x:Double x:Key="ControlContentThemeFontSize">13</x:Double>
            <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">10</CornerRadius>
            <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>

            <!-- Nexus tokens. Code-built pages read the same values from
                 Pages/NexusTokens.cs; keep the two in step.
                 Spacing: a 4px grid (4, 8, 12, 16, 24, 32).
                 Type ramp: page title 22, section 15, body 13.5, caption 12. -->
            <x:Double x:Key="NexusSpace1">4</x:Double>
            <x:Double x:Key="NexusSpace2">8</x:Double>
            <x:Double x:Key="NexusSpace3">12</x:Double>
            <x:Double x:Key="NexusSpace4">16</x:Double>
            <x:Double x:Key="NexusSpace6">24</x:Double>
            <x:Double x:Key="NexusSpace8">32</x:Double>
            <Thickness x:Key="NexusPagePadding">32,20,32,32</Thickness>
            <x:Double x:Key="NexusFontPageTitle">22</x:Double>
            <x:Double x:Key="NexusFontSection">15</x:Double>
            <x:Double x:Key="NexusFontBody">13.5</x:Double>
            <x:Double x:Key="NexusFontCaption">12</x:Double>
            <CornerRadius x:Key="NexusRadiusSmall">6</CornerRadius>
            <CornerRadius x:Key="NexusRadiusMedium">10</CornerRadius>
            <CornerRadius x:Key="NexusRadiusLarge">14</CornerRadius>
            <Style x:Key="NexusPageTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="22"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="LineHeight" Value="28"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <Style x:Key="NexusSectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <Style x:Key="NexusCaptionStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{ThemeResource NexusMutedTextBrush}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <Thickness x:Key="ButtonPadding">10,5,10,6</Thickness>
            <x:Double x:Key="ComboBoxMinHeight">28</x:Double>
            <x:Double x:Key="TextControlThemeMinHeight">30</x:Double>

            <!-- Primary buttons, one treatment across installer, desktop and
                 web: cream with ink text on dark, ink with cream text on
                 light; gold stays the accent (links, toggles, focus). Our
                 own template, so it never falls back to SystemAccentColor
                 (which put white text on gold in light mode). Keyed
                 AccentButtonStyle, so dialogs' primary buttons use it too. -->
            <Style x:Key="AccentButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource NexusPrimaryFillBrush}"/>
                <Setter Property="Foreground" Value="{ThemeResource NexusPrimaryInkBrush}"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="{StaticResource ButtonPadding}"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="{ThemeResource ControlContentThemeFontSize}"/>
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}"/>
                <Setter Property="UseSystemFocusVisuals" Value="True"/>
                <Setter Property="FocusVisualMargin" Value="-3"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter
                                x:Name="ContentPresenter"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                ContentTransitions="{TemplateBinding ContentTransitions}"
                                Padding="{TemplateBinding Padding}"
                                Foreground="{TemplateBinding Foreground}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                AutomationProperties.AccessibilityView="Raw">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="ContentPresenter.Background" Value="{ThemeResource NexusPrimaryFillHoverBrush}"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="ContentPresenter.Background" Value="{ThemeResource NexusPrimaryFillPressedBrush}"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="ContentPresenter.Background" Value="{ThemeResource NexusPrimaryFillDisabledBrush}"/>
                                                <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource NexusPrimaryInkDisabledBrush}"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </ContentPresenter>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <ResourceDictionary.ThemeDictionaries>
