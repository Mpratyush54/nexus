                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#D9A752"/>
                    <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#0E0F0E"/>
                    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#0E0F0E"/>
                    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#0E0F0E"/>
                    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#E8BB67"/>
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#F0CE8D"/>
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#0E0F0E"/>
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#0E0F0E"/>
