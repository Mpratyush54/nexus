<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Nexus.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Typography and shape (reference: T3 Code). System UI font, quiet
                 6px controls, 10px overlays. -->
            <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
            <x:Double x:Key="ControlContentThemeFontSize">13</x:Double>
            <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">10</CornerRadius>
            <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>

            <!-- Nexus tokens. Code-built pages read the same values from
                 Pages/NexusTokens.cs; keep the two in step.
                 Spacing: a 4px grid (4, 8, 12, 16, 24, 32).
                 Type ramp: page title 22, section 15, body 13.5, caption 12. -->
            <x:Double x:Key="NexusSpace1">4</x:Double>
            <x:Double x:Key="NexusSpace2">8</x:Double>
            <x:Double x:Key="NexusSpace3">12</x:Double>
            <x:Double x:Key="NexusSpace4">16</x:Double>
            <x:Double x:Key="NexusSpace6">24</x:Double>
            <x:Double x:Key="NexusSpace8">32</x:Double>
            <Thickness x:Key="NexusPagePadding">32,20,32,32</Thickness>
            <x:Double x:Key="NexusFontPageTitle">22</x:Double>
            <x:Double x:Key="NexusFontSection">15</x:Double>
            <x:Double x:Key="NexusFontBody">13.5</x:Double>
            <x:Double x:Key="NexusFontCaption">12</x:Double>
            <CornerRadius x:Key="NexusRadiusSmall">6</CornerRadius>
            <CornerRadius x:Key="NexusRadiusMedium">10</CornerRadius>
            <CornerRadius x:Key="NexusRadiusLarge">14</CornerRadius>
            <Style x:Key="NexusPageTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="22"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="LineHeight" Value="28"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <Style x:Key="NexusSectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <Style x:Key="NexusCaptionStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{ThemeResource NexusMutedTextBrush}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <Thickness x:Key="ButtonPadding">10,5,10,6</Thickness>
            <x:Double x:Key="ComboBoxMinHeight">28</x:Double>
            <x:Double x:Key="TextControlThemeMinHeight">30</x:Double>

            <ResourceDictionary.ThemeDictionaries>
                <!-- Dark: the brand ink canvas (#0E0F0E, as in the installer and
                     the landing page), surfaces lifted ~3%, hairline white
                     borders, white-alpha hover/selection; no grey fills. -->
                <ResourceDictionary x:Key="Dark">
                    <!-- Brand gold on ink, as in the logo, landing page, portal
                         and installer. Controls take the fill from
                         SystemAccentColorLight2 (#E8BB67) with dark text on it
                         (11.7:1); accent text uses Light3 (#F5D79A, 15:1 on
                         the black canvas). The brushes below mirror that, with
                         the brand ink #0E0F0E as text on gold. -->
                    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#2A2A26"/>
                    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#E8BB67"/>
                    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#F0CE8D"/>
                    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#D9A752"/>
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#D9A752"/>
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#0E0F0E"/>
                    <Color x:Key="SystemAccentColor">#E8BB67</Color>
                    <Color x:Key="SystemAccentColorLight1">#F0CE8D</Color>
                    <Color x:Key="SystemAccentColorLight2">#E8BB67</Color>
                    <Color x:Key="SystemAccentColorLight3">#F5D79A</Color>
                    <Color x:Key="SystemAccentColorDark1">#D9A752</Color>
                    <Color x:Key="SystemAccentColorDark2">#B8862E</Color>
                    <Color x:Key="SystemAccentColorDark3">#8A5F12</Color>
                    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#0E0F0E"/>
                    <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#E8BB67"/>
                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#F0CE8D"/>
                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#D9A752"/>
                    <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#0E0F0E"/>
                    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#0E0F0E"/>
                    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#0E0F0E"/>
                    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#E8BB67"/>
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#F0CE8D"/>
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#0E0F0E"/>
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#0E0F0E"/>
                    <SolidColorBrush x:Key="NexusSkeletonBrush" Color="#14FFFFFF"/>
                    <Color x:Key="NexusSkeletonHighlightColor">#24FFFFFF</Color>
                    <SolidColorBrush x:Key="NexusDangerBrush" Color="#F28B8B"/>
                    <SolidColorBrush x:Key="NexusDangerFillBrush" Color="#1AF28B8B"/>
                    <SolidColorBrush x:Key="NexusHoverFillBrush" Color="#0DFFFFFF"/>
                    <Color x:Key="NexusSidebarColor">#D90E0F0E</Color>
                    <Color x:Key="NexusCanvasColor">#0E0F0E</Color>
                    <SolidColorBrush x:Key="NexusCanvasBrush" Color="#0E0F0E"/>
                    <SolidColorBrush x:Key="NexusSurfaceBrush" Color="#171817"/>
                    <SolidColorBrush x:Key="NexusHairlineBrush" Color="#14FFFFFF"/>
                    <SolidColorBrush x:Key="NexusMutedTextBrush" Color="#A3A3A3"/>
                    <SolidColorBrush x:Key="NexusAccentBrush" Color="#E8BB67"/>
                    <SolidColorBrush x:Key="NexusTealBrush" Color="#A3A3A3"/>
                    <SolidColorBrush x:Key="NexusAmberBrush" Color="#FBBF24"/>
                    <SolidColorBrush x:Key="NexusUserFillBrush" Color="#1D1E1D"/>
                    <SolidColorBrush x:Key="NexusAccentBorderBrush" Color="#14FFFFFF"/>
                    <SolidColorBrush x:Key="NexusAccentFillBrush" Color="#12FFFFFF"/>

                    <!-- Text -->
                    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#F2F2F2"/>
                    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#A3A3A3"/>
                    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#737373"/>
                    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#525252"/>
                    <SolidColorBrush x:Key="DefaultTextForegroundThemeBrush" Color="#F2F2F2"/>

                    <!-- Surfaces and strokes -->
                    <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#0E0F0E"/>
                    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#131413"/>
                    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#14FFFFFF"/>
                    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#14FFFFFF"/>
                    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#14FFFFFF"/>
                    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#14FFFFFF"/>
                    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#00000000"/>
                    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#0E0F0E"/>

                    <!-- Accent fills: brand gold, ink text on it -->
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#E8BB67"/>
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#F0CE8D"/>
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#D9A752"/>
                    <!-- Primary buttons (AccentButtonStyle and dialog primary
                         buttons): cream with ink text, as in the installer and
                         the web portal. Gold stays the accent. -->
                    <SolidColorBrush x:Key="AccentButtonBackground" Color="#F2EFE6"/>
                    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#FBF9F3"/>
                    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#E4E1DB"/>
                    <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#14FFFFFF"/>
                    <SolidColorBrush x:Key="AccentButtonForeground" Color="#0E0F0E"/>
                    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#0E0F0E"/>
                    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#0E0F0E"/>
                    <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#66F2EFE6"/>
                    <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="#00000000"/>
                    <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="#00000000"/>
                    <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="#00000000"/>
                    <SolidColorBrush x:Key="AccentButtonBorderBrushDisabled" Color="#00000000"/>
                    <SolidColorBrush x:Key="NexusPrimaryFillBrush" Color="#F2EFE6"/>
                    <SolidColorBrush x:Key="NexusPrimaryInkBrush" Color="#0E0F0E"/>

                    <!-- Buttons: almost flat, hairline border -->
                    <SolidColorBrush x:Key="ButtonBackground" Color="#08FFFFFF"/>
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#12FFFFFF"/>
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#0AFFFFFF"/>
                    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#04FFFFFF"/>
                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#14FFFFFF"/>
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#1FFFFFFF"/>
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#14FFFFFF"/>
                    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#0AFFFFFF"/>
                    <SolidColorBrush x:Key="ButtonForeground" Color="#E5E5E5"/>
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#D4D4D4"/>
                    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#525252"/>

                    <!-- Pickers: ghost until hovered -->
                    <SolidColorBrush x:Key="ComboBoxBackground" Color="#00000000"/>
                    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#0FFFFFFF"/>
                    <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#0AFFFFFF"/>
                    <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="#0AFFFFFF"/>
                    <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="#00000000"/>
                    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#00000000"/>
                    <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#14FFFFFF"/>
                    <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#14FFFFFF"/>
                    <SolidColorBrush x:Key="ComboBoxBorderBrushFocused" Color="#1FFFFFFF"/>
                    <SolidColorBrush x:Key="ComboBoxForeground" Color="#D4D4D4"/>
                    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#161716"/>
                    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#1FFFFFFF"/>

                    <!-- Text inputs: quiet fill, hairline border, no accent underline -->
                    <SolidColorBrush x:Key="TextControlBackground" Color="#06FFFFFF"/>
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#0AFFFFFF"/>
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#0B0C0B"/>
                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#14FFFFFF"/>
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#1FFFFFFF"/>
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#33FFFFFF"/>
                    <SolidColorBrush x:Key="TextControlForeground" Color="#F2F2F2"/>
                    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#F2F2F2"/>
                    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#737373"/>
                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#737373"/>
                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#737373"/>

                    <!-- Navigation chrome -->
                    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#0E0F0E"/>
                    <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="#14FFFFFF"/>
                    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#0B0C0B"/>
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#0AFFFFFF"/>
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#10FFFFFF"/>
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#14FFFFFF"/>
                    <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#A3A3A3"/>
                    <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#F2F2F2"/>
                    <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="#E5E5E5"/>

                    <!-- Quiet fills for tool rows and scrollbars -->
                    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#08FFFFFF"/>
                    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#05FFFFFF"/>
                    <SolidColorBrush x:Key="ScrollBarThumbFill" Color="#33FFFFFF"/>
                    <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="#55FFFFFF"/>
                    <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="#66FFFFFF"/>
                    <SolidColorBrush x:Key="ScrollBarTrackFill" Color="#00000000"/>
                    <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="#00000000"/>

                    <!-- Expanders and flyouts -->
                    <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="#00000000"/>
                    <SolidColorBrush x:Key="ExpanderContentBackground" Color="#00000000"/>
                    <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="#0FFFFFFF"/>
                    <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="#0FFFFFFF"/>
                    <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#161716"/>
                    <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#161716"/>
                    <SolidColorBrush x:Key="ContentDialogBackground" Color="#151615"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <!-- Brand gold deepened for white (WCAG AA). WinUI's control
                         styles take the accent from SystemAccentColorDark1 and
                         always put white text on it in the light theme, so the
                         fill is #9A6A18: white text 4.7:1, and 4.7:1 against
                         the white page for toggles and indicators. Gold text
                         and icons use #8A5F12 (5.6:1). The brushes below
                         mirror that for code-built UI. -->
                    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#F2EFE6"/>
                    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#8A5F12"/>
                    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#6E4B0E"/>
                    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#9A6A18"/>
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#A87A26"/>
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#8A5F12"/>
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#8A5F12"/>
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FFFFFF"/>
                    <Color x:Key="SystemAccentColor">#B8862E</Color>
                    <Color x:Key="SystemAccentColorLight1">#C4923A</Color>
                    <Color x:Key="SystemAccentColorLight2">#D9A752</Color>
                    <Color x:Key="SystemAccentColorLight3">#E8BB67</Color>
                    <Color x:Key="SystemAccentColorDark1">#9A6A18</Color>
                    <Color x:Key="SystemAccentColorDark2">#8A5F12</Color>
                    <Color x:Key="SystemAccentColorDark3">#6E4B0E</Color>
                    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#9A6A18"/>
                    <!-- Primary buttons: brand ink with cream text, the web
                         portal's light primary. Gold stays the accent. -->
                    <SolidColorBrush x:Key="AccentButtonBackground" Color="#0E0F0E"/>
                    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#262826"/>
                    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#000000"/>
                    <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#0F000000"/>
                    <SolidColorBrush x:Key="AccentButtonForeground" Color="#F2EFE6"/>
                    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#F2EFE6"/>
                    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#E4E1DB"/>
                    <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#71717A"/>
                    <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="#00000000"/>
                    <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="#00000000"/>
                    <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="#00000000"/>
                    <SolidColorBrush x:Key="AccentButtonBorderBrushDisabled" Color="#00000000"/>
                    <SolidColorBrush x:Key="NexusPrimaryFillBrush" Color="#0E0F0E"/>
                    <SolidColorBrush x:Key="NexusPrimaryInkBrush" Color="#F2EFE6"/>
                    <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#9A6A18"/>
                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#A87A26"/>
                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#8A5F12"/>
                    <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#F2EFE6"/>
                    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#9A6A18"/>
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#A87A26"/>
                    <SolidColorBrush x:Key="NexusSkeletonBrush" Color="#0F000000"/>
                    <Color x:Key="NexusSkeletonHighlightColor">#06000000</Color>
                    <SolidColorBrush x:Key="NexusDangerBrush" Color="#B91C1C"/>
                    <SolidColorBrush x:Key="NexusDangerFillBrush" Color="#14B91C1C"/>
                    <SolidColorBrush x:Key="NexusHoverFillBrush" Color="#0A000000"/>
                    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#E4E4E7"/>
                    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#18181B"/>
                    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#52525B"/>
                    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#71717A"/>
                    <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#FFFFFF"/>
                    <Color x:Key="NexusSidebarColor">#E6F7F7F8</Color>
                    <Color x:Key="NexusCanvasColor">#FFFFFF</Color>
                    <SolidColorBrush x:Key="NexusCanvasBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="NexusSurfaceBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="NexusHairlineBrush" Color="#E4E4E7"/>
                    <SolidColorBrush x:Key="NexusMutedTextBrush" Color="#71717A"/>
                    <SolidColorBrush x:Key="NexusAccentBrush" Color="#8A5F12"/>
                    <SolidColorBrush x:Key="NexusTealBrush" Color="#71717A"/>
                    <SolidColorBrush x:Key="NexusAmberBrush" Color="#B45309"/>
                    <SolidColorBrush x:Key="NexusUserFillBrush" Color="#EEEEF0"/>
                    <SolidColorBrush x:Key="NexusAccentBorderBrush" Color="#E4E4E7"/>
                    <SolidColorBrush x:Key="NexusAccentFillBrush" Color="#F4F4F5"/>
                    <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="#E4E4E7"/>
                    <SolidColorBrush x:Key="ComboBoxBackground" Color="#00000000"/>
                    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#00000000"/>
                    <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="#00000000"/>
                    <SolidColorBrush x:Key="ExpanderContentBackground" Color="#00000000"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="NexusSkeletonBrush" Color="{ThemeResource SystemColorGrayTextColor}"/>
                    <StaticResource x:Key="NexusSkeletonHighlightColor" ResourceKey="SystemColorWindowColor"/>
                    <SolidColorBrush x:Key="NexusDangerBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="NexusDangerFillBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="NexusHoverFillBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
                    <StaticResource x:Key="NexusSidebarColor" ResourceKey="SystemColorWindowColor"/>
                    <StaticResource x:Key="NexusCanvasColor" ResourceKey="SystemColorWindowColor"/>
                    <SolidColorBrush x:Key="NexusCanvasBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="NexusSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="NexusHairlineBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="NexusMutedTextBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="NexusAccentBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
                    <SolidColorBrush x:Key="NexusTealBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="NexusAmberBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="NexusUserFillBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="NexusAccentBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="NexusAccentFillBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
