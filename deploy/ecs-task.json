{
  "_comment": "SAMPLE ecs-task.json — Fargate task definition template for central-server. Regenerated per #112 (shell-capable alpine base, /readyz healthcheck, DATABASE_URL + JWT_SECRET contract, MIGRATIONS_DIR /migrations). Fill in ACCOUNT/REGION/secret ARNs before registering. Templates/notes only — do not apply blindly. The taskRoleArn below matches the task role created in infra/terraform/ecs.tf (least-privilege; S3 cold-writer is deferred per #128, so it grants no S3 access yet).",
  "family": "central-server",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::ACCOUNT:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::ACCOUNT:role/central-memory-task",
  "containerDefinitions": [
    {
      "name": "central-server",
      "image": "ACCOUNT.dkr.ecr.REGION.amazonaws.com/central-server:COMMIT_SHA",
      "essential": true,
      "portMappings": [{ "containerPort": 8080, "protocol": "tcp" }],
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:REGION:ACCOUNT:secret:central-memory/db-app:database_url::"
        },
        {
          "name": "JWT_SECRET",
          "valueFrom": "arn:aws:secretsmanager:REGION:ACCOUNT:secret:central-memory/jwt:signing_key::"
        },
        {
          "name": "OPENROUTER_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:REGION:ACCOUNT:secret:openrouter:api_key::"
        }
      ],
      "environment": [
        { "name": "PORT", "value": "8080" },
        { "name": "DB_SSLMODE", "value": "require" },
        { "name": "MIGRATIONS_DIR", "value": "/migrations" },
        { "name": "OPENROUTER_MODEL", "value": "nvidia/nemotron-3.5-lightning:free" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/central-server",
          "awslogs-region": "REGION",
          "awslogs-stream-prefix": "server"
        }
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "wget -qO- http://localhost:8080/readyz | grep -q '\"ok\":true' || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 120
      }
    }
  ]
}
